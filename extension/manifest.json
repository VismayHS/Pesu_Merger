{
  "manifest_version": 3,
  "name": "PESU Academy Downloader",
  "version": "1.1.0",
  "description": "Only for pesuacademy.com: download, convert (PPT/DOC to PDF) and merge course material by unit and category, and export MCQs with answers.",
  "key": "",
  "action": {
    "default_title": "PESU Academy Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "downloads.ui",
    "storage",
    "unlimitedStorage",
    "scripting",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.pesuacademy.com/*",
    "https://pesuacademy.com/*",
    "https://files.pesuacademy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.pesuacademy.com/Academy/*",
        "https://pesuacademy.com/Academy/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}
